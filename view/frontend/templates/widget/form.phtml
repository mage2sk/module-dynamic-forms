    '@context' => 'https://schema.org',
    '@type' => 'WebPage',
    'name' => $form->getData('meta_title') ?: ($form->getData('title') ?: $form->getData('name')),
    'description' => $form->getData('meta_description') ?: ($form->getData('description') ?: ''),
    'url' => $canonicalUrl,
    'datePublished' => date('c', strtotime($createdAt)),
    'dateModified' => date('c', strtotime($updatedAt)),
    'mainEntity' => ['@type' => 'ContactPage', 'name' => $form->getData('title') ?: $form->getData('name'), 'url' => $canonicalUrl],
], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_HEX_TAG) ?>
</script>
<?php endif; ?>

<script>
(function() {
    var fid = <?= /* @noEscape */ $formId ?>;
    var submitUrl = '<?= /* @noEscape */ $escaper->escapeJs($submitUrl) ?>';
    var uploadUrl = '<?= /* @noEscape */ $escaper->escapeJs($uploadUrl) ?>';
    var successMsg = '<?= /* @noEscape */ $successMsg ?>';
    var redirectUrl = '<?= /* @noEscape */ $escaper->escapeJs($redirectUrl) ?>';
    var cfg = <?= /* @noEscape */ $block->getFormConfig() ?>;
    var msg = <?= /* @noEscape */ $block->getClientMessagesJson() ?>;
    var form = document.getElementById('pdf-form-' + fid);
    if (!form) return;

    function fmt(text) {
        var out = String(text);
        for (var i = 1; i < arguments.length; i++) {
            out = out.split('%' + i).join(String(arguments[i]));
        }
        return out;
    }

    function wrapperOf(name) {
        var all = form.querySelectorAll('[data-field]');
        for (var i = 0; i < all.length; i++) {
            if (all[i].getAttribute('data-field') === name) return all[i];
        }
        return null;
    }

    function controlsOf(wrap) {
        return Array.prototype.slice.call(wrap.querySelectorAll('input:not([type=hidden]):not(.pdf-file-input), select, textarea, .pdf-drop'));
    }

    function valueOf(wrap) {
        var type = wrap.dataset.type;
        if (type === 'file') {
            var hidden = wrap.querySelector('input[type="hidden"]');
            return hidden ? hidden.value.trim() : '';
        }
        if (type === 'checkbox' || type === 'radio') {
            var checked = wrap.querySelectorAll('input:checked');
            var vals = [];
            for (var i = 0; i < checked.length; i++) vals.push(checked[i].value);
            return vals.join(', ');
        }
        if (type === 'multiselect') {
            var sel = wrap.querySelector('select');
            var picked = [];
            for (var j = 0; j < sel.options.length; j++) if (sel.options[j].selected) picked.push(sel.options[j].value);
            return picked.join(', ');
        }
        var el = wrap.querySelector('input, select, textarea');
        return el ? el.value.trim() : '';
    }

    function rulesOf(wrap) {
        try {
            var parsed = JSON.parse(wrap.dataset.rules || '{}');
            return parsed && typeof parsed === 'object' ? parsed : {};
        } catch (e) {
            return {};
        }
    }

    function validateWrap(wrap) {
        var name = wrap.getAttribute('data-field');
        var type = wrap.dataset.type || 'text';
        var label = wrap.dataset.label || name;
        var val = valueOf(wrap);

        if (val === '') {
            if (wrap.dataset.required === '1') { showFieldError(name, fmt(msg.required, label)); return false; }
            clearError(name);
            return true;
        }
        if (type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) { showFieldError(name, msg.email); return false; }
        if (type === 'phone' && !/^[\d\s\-+().]{7,20}$/.test(val)) { showFieldError(name, msg.phone); return false; }
        if (type === 'number' && isNaN(Number(val))) { showFieldError(name, msg.number); return false; }

        var x = rulesOf(wrap);
        var isNum = !isNaN(Number(val));
        if (x.min_length !== undefined && val.length < Number(x.min_length)) { showFieldError(name, fmt(msg.minLength, label, x.min_length)); return false; }
        if (x.max_length !== undefined && val.length > Number(x.max_length)) { showFieldError(name, fmt(msg.maxLength, label, x.max_length)); return false; }
        if (x.min !== undefined && isNum && Number(val) < Number(x.min)) { showFieldError(name, fmt(msg.min, label, x.min)); return false; }
        if (x.max !== undefined && isNum && Number(val) > Number(x.max)) { showFieldError(name, fmt(msg.max, label, x.max)); return false; }
        if (x.pattern !== undefined && x.pattern !== '') {
            var re = null;
            try { re = new RegExp(String(x.pattern)); } catch (e) { re = null; }
            if (re && !re.test(val)) { showFieldError(name, x.pattern_message || fmt(msg.pattern, label)); return false; }
        }
        clearError(name);
        return true;
    }

    function showFieldError(name, text) {
        var errEl = document.getElementById('pdf-err-' + fid + '-' + name);
        var wrap = wrapperOf(name);
        if (errEl) { errEl.textContent = text; errEl.classList.add('visible'); }
        if (wrap) {
            controlsOf(wrap).forEach(function(el) {
                el.classList.add('err');
                el.setAttribute('aria-invalid', 'true');
                if (errEl) el.setAttribute('aria-describedby', errEl.id);
            });
        }
    }

    function clearError(name) {
        var errEl = document.getElementById('pdf-err-' + fid + '-' + name);
        var wrap = wrapperOf(name);
        if (errEl) { errEl.textContent = ''; errEl.classList.remove('visible'); }
        if (wrap) {
            controlsOf(wrap).forEach(function(el) {
                el.classList.remove('err');
                el.removeAttribute('aria-invalid');
                el.removeAttribute('aria-describedby');
            });
        }
    }

    function focusFirstError(globalErr) {
        var firstBad = null;
        var bad = form.querySelectorAll('[aria-invalid="true"]');
        for (var i = 0; i < bad.length; i++) {
            if (bad[i].offsetParent !== null) { firstBad = bad[i]; break; }
        }
        var target = firstBad || globalErr;
        if (target) {
            target.focus({ preventScroll: true });
            target.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
    }

    form.querySelectorAll('[data-file-field]').forEach(function(zone) {
        var fieldName = zone.getAttribute('data-file-field');
        var wrap = wrapperOf(fieldName);
        var fileInput = wrap.querySelector('.pdf-file-input');
        var hiddenInput = wrap.querySelector('input[type="hidden"]');
        zone.addEventListener('click', function() { fileInput.click(); });
        zone.addEventListener('dragover', function(e) { e.preventDefault(); zone.style.borderColor = 'var(--color-primary, #0D9488)'; });
        zone.addEventListener('dragleave', function(e) { e.preventDefault(); zone.style.borderColor = ''; });
        zone.addEventListener('drop', function(e) { e.preventDefault(); zone.style.borderColor = ''; if (e.dataTransfer.files[0]) doUpload(fieldName, e.dataTransfer.files[0]); });
        fileInput.addEventListener('change', function() { if (this.files[0]) doUpload(fieldName, this.files[0]); });

        var fileDisplay = document.getElementById('pdf-file-' + fid + '-' + fieldName);
        if (fileDisplay) {
            fileDisplay.querySelector('.pdf-file-remove').addEventListener('click', function() {
                fileDisplay.style.display = 'none';
                zone.style.display = '';
                hiddenInput.value = '';
                fileInput.value = '';
                zone.focus();
            });
        }
    });

    function doUpload(fieldName, file) {
        var wrap = wrapperOf(fieldName);
        var zone = wrap.querySelector('.pdf-drop');
        var prog = document.getElementById('pdf-prog-' + fid + '-' + fieldName);
        var fileDisp = document.getElementById('pdf-file-' + fid + '-' + fieldName);
        var hidden = wrap.querySelector('input[type="hidden"]');
        var bar = prog.querySelector('.pdf-progress-bar');
        var ext = (file.name.split('.').pop() || '').toLowerCase();

        if (cfg.allowed_extensions && cfg.allowed_extensions.length && cfg.allowed_extensions.indexOf(ext) === -1) {
            showFieldError(fieldName, fmt(msg.fileType, cfg.allowed_extensions.join(', ')));
            return;
        }
        if (cfg.max_file_size && file.size > cfg.max_file_size) {
            showFieldError(fieldName, fmt(msg.fileTooBig, Math.round(cfg.max_file_size_mb * 100) / 100));
            return;
        }

        prog.classList.add('active');
        bar.style.width = '0%';

        var fd = new FormData();
        fd.append('file', file);
        fd.append('form_key', form.querySelector('[name="form_key"]').value);
        fd.append('field_name', fieldName);
        fd.append('form_id', String(fid));

        var xhr = new XMLHttpRequest();
        xhr.upload.onprogress = function(e) { if (e.lengthComputable) bar.style.width = Math.round(e.loaded / e.total * 100) + '%'; };
        xhr.onload = function() {
            prog.classList.remove('active');
            try {
                var res = JSON.parse(xhr.responseText);
                if (res.success !== false && res.file) {
                    hidden.value = res.file;
                    zone.style.display = 'none';
                    fileDisp.style.display = 'flex';
                    fileDisp.querySelector('.pdf-file-name').textContent = file.name;
                    clearError(fieldName);
                } else {
                    showFieldError(fieldName, res.message || msg.uploadFailed);
                }
            } catch (e) { showFieldError(fieldName, msg.uploadFailed); }
        };
        xhr.onerror = function() { prog.classList.remove('active'); showFieldError(fieldName, msg.uploadFailed); };
        xhr.open('POST', uploadUrl);
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
        xhr.send(fd);
    }

    form.querySelectorAll('[data-field]').forEach(function(wrap) {
        var type = wrap.dataset.type;
        wrap.querySelectorAll('input:not([type=hidden]):not(.pdf-file-input), select, textarea').forEach(function(el) {
            if (type === 'checkbox' || type === 'radio') {
                el.addEventListener('change', function() { validateWrap(wrap); });
            } else {
                el.addEventListener('blur', function() { validateWrap(wrap); });
                el.addEventListener('change', function() { validateWrap(wrap); });
            }
        });
    });

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        var globalErr = document.getElementById('pdf-global-err-' + fid);
        var globalErrMsg = document.getElementById('pdf-global-err-msg-' + fid);
        globalErr.classList.remove('visible');

        var valid = true;
        form.querySelectorAll('[data-field]').forEach(function(wrap) {
            if (!validateWrap(wrap)) valid = false;
        });
        if (!valid) {
            globalErrMsg.textContent = msg.fix;
            globalErr.classList.add('visible');
            focusFirstError(globalErr);
            return;
        }

        var btn = document.getElementById('pdf-submit-' + fid);
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner" aria-hidden="true"></span> ' + '<?= /* @noEscape */ $escaper->escapeJs($escaper->escapeHtml($block->getLoadingText())) ?>';

        var fd = new FormData(form);

        function restoreButton() {
            btn.disabled = false;
            btn.innerHTML = '<span class="pdf-btn-text">' + '<?= /* @noEscape */ $escaper->escapeJs($btnText) ?>' + '</span>';
        }

        fetch(submitUrl, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.success) {
                    document.getElementById('pdf-form-card-' + fid).style.display = 'none';
                    var sc = document.getElementById('pdf-success-' + fid);
                    sc.classList.add('visible');
                    document.getElementById('pdf-success-msg-' + fid).textContent = data.message || successMsg;
                    sc.focus({ preventScroll: true });
                    sc.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    if (redirectUrl) setTimeout(function() { window.location.href = redirectUrl; }, 2000);
                } else {
                    if (data.errors) Object.keys(data.errors).forEach(function(k) { showFieldError(k, data.errors[k]); });
                    globalErrMsg.textContent = data.message || msg.generic;
                    globalErr.classList.add('visible');
                    restoreButton();
                    focusFirstError(globalErr);
                }
            })
            .catch(function() {
                globalErrMsg.textContent = msg.network;
                globalErr.classList.add('visible');
                restoreButton();
                focusFirstError(globalErr);
            });
    });
})();
</script>
