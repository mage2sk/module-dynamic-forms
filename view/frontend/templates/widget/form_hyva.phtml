                                        <span x-text="files.<?= /* @noEscape */ $eName ?>.name" style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
                                        <button type="button" class="pdf-file-remove" aria-label="<?= /* @noEscape */ $escaper->escapeHtmlAttr(__('Remove file')) ?>" @click="removeFile('<?= /* @noEscape */ $escaper->escapeJs($name) ?>')">&times;</button>
                                    </div>
                                </template>
                            <?php endif; ?>

                            <p class="pdf-err" id="<?= /* @noEscape */ $errId ?>" x-show="errs.<?= /* @noEscape */ $eName ?>" x-text="errs.<?= /* @noEscape */ $eName ?>"></p>
                            <?php if ($isGroup): ?>
                            </fieldset>
                            <?php endif; ?>
                        </div>
                    <?php endif; ?>
                    <?php endforeach; ?>
                </div>

                <button type="submit" class="pdf-btn" :disabled="loading">
                    <template x-if="loading">
                        <svg aria-hidden="true" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" style="opacity:.25"/><path fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4z" style="opacity:.75"/></svg>
                    </template>
                    <span x-text="loading ? '<?= /* @noEscape */ $escaper->escapeJs($block->getLoadingText()) ?>' : '<?= /* @noEscape */ $escaper->escapeJs($btnText) ?>'"></span>
                </button>
            </form>
        </div>
    </template>
</div>

<?php if ($contentBelow): ?>
<div class="pdf-content prose mt-6"><?= /** @noEscape */ $contentBelow ?></div>
<?php endif; ?>

<?php if ($isPage && $canonicalUrl):
    $createdAt = $form->getData('created_at') ?: date('c');
    $updatedAt = $form->getData('updated_at') ?: $createdAt;
?>
<script type="application/ld+json">
<?= /* @noEscape */ json_encode([
    '@context' => 'https://schema.org',
    '@type' => 'WebPage',
    'name' => $form->getData('meta_title') ?: ($form->getData('title') ?: $form->getData('name')),
    'description' => $form->getData('meta_description') ?: ($form->getData('description') ?: ''),
    'url' => $canonicalUrl,
    'datePublished' => date('c', strtotime($createdAt)),
    'dateModified' => date('c', strtotime($updatedAt)),
    'mainEntity' => [
        '@type' => 'ContactPage',
        'name' => $form->getData('title') ?: $form->getData('name'),
        'url' => $canonicalUrl,
    ],
], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT | JSON_HEX_TAG) ?>
</script>
<?php endif; ?>

<script>
function <?= /** @noEscape */ $fid ?>() {
    const cfg = <?= /** @noEscape */ $block->getFormConfig() ?>;
    const fieldsDef = <?= /** @noEscape */ $block->getFieldsJson() ?>;
    const msg = <?= /** @noEscape */ $block->getClientMessagesJson() ?>;
    const fmt = (text, ...args) => args.reduce((out, arg, i) => out.split('%' + (i + 1)).join(String(arg)), text);
    const errPrefix = 'pdf-err-<?= /* @noEscape */ $formId ?>-';

    return {
        fd: {}, errs: {}, rules: {}, loading: false, success: false,
        successMessage: '', globalError: '', formKey: '',
        files: {}, uploading: {}, uploadProg: {}, dragging: {},

        init() {
            const m = document.cookie.match(/form_key=([^;]+)/);
            this.formKey = m ? m[1] : '';

            fieldsDef.forEach(f => {
                const multi = f.type === 'multiselect' || (f.type === 'checkbox' && Array.isArray(f.options) && f.options.length > 0);
                if (f.type === 'checkbox' && !multi) {
                    this.fd[f.name] = false;
                } else if (multi) {
                    this.fd[f.name] = f.default_value ? [f.default_value] : [];
                } else {
                    this.fd[f.name] = f.default_value || '';
                }
                this.errs[f.name] = '';
                this.files[f.name] = null;
                this.uploading[f.name] = false;
                this.uploadProg[f.name] = 0;
                this.dragging[f.name] = false;
                this.rules[f.name] = {
                    required: f.is_required,
                    type: f.type,
                    label: f.label,
                    extra: (f.validation_rules && typeof f.validation_rules === 'object') ? f.validation_rules : {}
                };
            });
            this.rootEl = this.$el;
            this.$watch('errs', () => this.syncAria());
        },

        fieldEls(name) {
            const root = this.rootEl || this.$el;
            const found = Array.from(root.querySelectorAll('[name="' + name + '"]:not([type=hidden]), [name="' + name + '[]"]'));
            const drop = root.querySelector('[data-file-field="' + name + '"]');
            if (drop) found.push(drop);
            return found;
        },

        syncAria() {
            fieldsDef.forEach(f => {
                this.fieldEls(f.name).forEach(el => {
                    if (this.errs[f.name]) {
                        el.setAttribute('aria-invalid', 'true');
                        el.setAttribute('aria-describedby', errPrefix + f.name);
                    } else {
                        el.removeAttribute('aria-invalid');
                        el.removeAttribute('aria-describedby');
                    }
                });
            });
        },

        focusFirstError() {
            const bad = fieldsDef.find(f => this.errs[f.name]);
            const el = bad ? this.fieldEls(bad.name).find(e => e.offsetParent !== null) : null;
            if (el) {
                el.focus({ preventScroll: true });
                el.scrollIntoView({ block: 'center', behavior: 'smooth' });
                return;
            }
            const root = this.rootEl || this.$el;
            const alert = root.querySelector('.pdf-alert');
            if (alert) {
                alert.focus({ preventScroll: true });
                alert.scrollIntoView({ block: 'center', behavior: 'smooth' });
            }
        },

        isFilled(name) {
            const r = this.rules[name];
            const v = this.fd[name];
            if (r.type === 'file') return !!this.files[name];
            if (Array.isArray(v)) return v.length > 0;
            if (typeof v === 'boolean') return v;
            return !!(v && String(v).trim());
        },

        validate(name) {
            const r = this.rules[name];
            if (!r) return true;
            const label = r.label;

            if (!this.isFilled(name)) {
                if (r.required) {
                    this.errs[name] = fmt(msg.required, label);
                    return false;
                }
                this.errs[name] = '';
                return true;
            }

            const raw = this.fd[name];
            const v = Array.isArray(raw) ? raw.join(', ') : (typeof raw === 'boolean' ? '1' : String(raw).trim());

            if (r.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) {
                this.errs[name] = msg.email; return false;
            }
            if (r.type === 'phone' && !/^[\d\s\-+().]{7,20}$/.test(v)) {
                this.errs[name] = msg.phone; return false;
            }
            if (r.type === 'number' && (v === '' || isNaN(Number(v)))) {
                this.errs[name] = msg.number; return false;
            }

            const x = r.extra;
            const isNum = v !== '' && !isNaN(Number(v));
            if (x.min_length !== undefined && v.length < Number(x.min_length)) {
                this.errs[name] = fmt(msg.minLength, label, x.min_length); return false;
            }
            if (x.max_length !== undefined && v.length > Number(x.max_length)) {
                this.errs[name] = fmt(msg.maxLength, label, x.max_length); return false;
            }
            if (x.min !== undefined && isNum && Number(v) < Number(x.min)) {
                this.errs[name] = fmt(msg.min, label, x.min); return false;
            }
            if (x.max !== undefined && isNum && Number(v) > Number(x.max)) {
                this.errs[name] = fmt(msg.max, label, x.max); return false;
            }
            if (x.pattern !== undefined && x.pattern !== '') {
                let re = null;
                try { re = new RegExp(String(x.pattern)); } catch (e) { re = null; }
                if (re && !re.test(v)) {
                    this.errs[name] = x.pattern_message || fmt(msg.pattern, label); return false;
                }
            }

            this.errs[name] = '';
            return true;
        },

        validateAll() {
            let valid = true;
            fieldsDef.forEach(f => {
                if (f.type !== 'hidden' && !this.validate(f.name)) valid = false;
            });
            return valid;
        },

        async uploadFile(name, file) {
            if (!file) return;
            const ext = (file.name.split('.').pop() || '').toLowerCase();
            if (Array.isArray(cfg.allowed_extensions) && cfg.allowed_extensions.length && cfg.allowed_extensions.indexOf(ext) === -1) {
                this.errs[name] = fmt(msg.fileType, cfg.allowed_extensions.join(', '));
                return;
            }
            if (cfg.max_file_size && file.size > cfg.max_file_size) {
                this.errs[name] = fmt(msg.fileTooBig, Math.round(cfg.max_file_size_mb * 100) / 100);
                return;
            }
            this.uploading[name] = true;
            this.uploadProg[name] = 0;

            const fd = new FormData();
            fd.append('file', file);
            fd.append('form_key', this.formKey);
            fd.append('field_name', name);
            fd.append('form_id', String(cfg.form_id));

            try {
                const xhr = new XMLHttpRequest();
                xhr.upload.onprogress = (e) => {
                    if (e.lengthComputable) this.uploadProg[name] = Math.round((e.loaded / e.total) * 100);
                };
                const result = await new Promise((resolve, reject) => {
                    xhr.onload = () => { try { resolve(JSON.parse(xhr.responseText)); } catch (e) { reject(e); } };
                    xhr.onerror = () => reject(new Error('Upload failed'));
                    xhr.open('POST', cfg.upload_url);
                    xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                    xhr.send(fd);
                });
                if (result.success !== false && result.file) {
                    this.files[name] = { name: file.name, file: result.file };
                    this.fd[name] = result.file;
                    this.errs[name] = '';
                } else {
                    this.errs[name] = result.message || msg.uploadFailed;
                }
            } catch (e) {
                this.errs[name] = msg.uploadFailed;
            }
            this.uploading[name] = false;
        },

        removeFile(name) {
            this.files[name] = null;
            this.fd[name] = '';
            if (this.$refs['file_' + name]) this.$refs['file_' + name].value = '';
            this.$nextTick(() => {
                const drop = (this.rootEl || this.$el).querySelector('[data-file-field="' + name + '"]');
                if (drop) drop.focus();
            });
        },

        showErrors() {
            this.$nextTick(() => {
                this.syncAria();
                this.focusFirstError();
            });
        },

        async submit() {
            this.globalError = '';
            if (!this.validateAll()) {
                this.globalError = msg.fix;
                this.showErrors();
                return;
            }
            this.loading = true;

            const fd = new FormData();
            fd.append('form_key', this.formKey);
            fd.append('form_id', '<?= /* @noEscape */ $formId ?>');
            const hp = document.getElementById('pdf-hp-<?= /* @noEscape */ $formId ?>')
                || document.querySelector('[name="<?= $escaper->escapeJs($block->getHoneypotFieldName()) ?>"]');
            if (hp) { fd.append(hp.name, hp.value); }
            fieldsDef.forEach(f => {
                const v = this.fd[f.name];
                if (Array.isArray(v)) {
                    v.forEach(item => fd.append(f.name + '[]', item));
                } else if (typeof v === 'boolean') {
                    fd.append(f.name, v ? '1' : '');
                } else {
                    fd.append(f.name, v || '');
                }
            });

            try {
                const resp = await fetch(cfg.submit_url, { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await resp.json();
                if (data.success) {
                    this.success = true;
                    this.successMessage = data.message || cfg.success_message || '<?= /* @noEscape */ $escaper->escapeJs($successMsg) ?>';
                    this.$nextTick(() => {
                        const card = (this.rootEl || this.$el).querySelector('.pdf-success-card');
                        if (card) {
                            card.focus({ preventScroll: true });
                            card.scrollIntoView({ block: 'center', behavior: 'smooth' });
                        }
                    });
                    if (cfg.redirect_url) setTimeout(() => window.location.href = cfg.redirect_url, 2000);
                } else {
                    if (data.errors) {
                        Object.keys(data.errors).forEach(k => { this.errs[k] = data.errors[k]; });
                    }
                    this.globalError = data.message || msg.generic;
                    this.showErrors();
                }
            } catch (e) {
                this.globalError = msg.network;
                this.showErrors();
            }
            this.loading = false;
        }
    };
}
</script>
